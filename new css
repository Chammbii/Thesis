/* =====================================================
   QUIZ STAR SCORE
===================================================== */

.quiz-star-score{
    position:fixed;
    top:24px;
    left:24px;
    right:auto;
    z-index:1200;
    display:none;
    align-items:center;
    gap:8px;
    min-width:118px;
    padding:12px 16px;
    border-radius:18px;
    background:linear-gradient(145deg,#fff6d6,#ffe08a);
    border:2px solid rgba(255,183,3,.55);
    box-shadow:0 10px 24px rgba(255,183,3,.28);
    transform-origin:center;
    transition:transform .2s ease, box-shadow .2s ease;
}

.quiz-star-score.is-visible{
    display:flex;
}

.floating-settings-btn{
    position:fixed;
    top:24px;
    right:24px;
    z-index:1200;
    width:56px;
    height:56px;
    border:none;
    border-radius:18px;
    display:none;
    place-items:center;
    cursor:pointer;
    color:#fff;
    font-size:24px;
    background:linear-gradient(145deg,#ffb703,#ff8a4c);
    box-shadow:0 10px 24px rgba(255,183,3,.35);
    transition:transform .2s ease, box-shadow .2s ease, filter .2s ease;
}

.floating-teacher-btn{
    position:fixed;
    top:24px;
    right:92px;
    z-index:1200;
    width:56px;
    height:56px;
    border:none;
    border-radius:18px;
    display:none;
    place-items:center;
    cursor:pointer;
    color:#fff;
    font-size:24px;
    background:linear-gradient(145deg,#3a86ff,#4361ee);
    box-shadow:0 10px 24px rgba(58,134,255,.35);
    transition:transform .2s ease, box-shadow .2s ease, filter .2s ease;
}

.floating-settings-btn.is-visible{
    display:grid;
}

.floating-teacher-btn.is-visible{
    display:grid;
}

.floating-settings-btn:hover{
    transform:translateY(-2px) rotate(25deg) scale(1.05);
    box-shadow:0 14px 28px rgba(255,138,76,.42);
    filter:brightness(1.05);
}

.floating-teacher-btn:hover{
    transform:translateY(-2px) scale(1.05);
    box-shadow:0 14px 28px rgba(58,134,255,.45);
    filter:brightness(1.05);
}

.floating-settings-btn:active{
    transform:scale(0.96);
}

.floating-teacher-btn:active{
    transform:scale(0.96);
}

.quiz-star-score:hover{
    transform:translateY(-2px) scale(1.03);
    box-shadow:0 14px 28px rgba(255,183,3,.38);
}

.quiz-star-icon{
    font-size:34px;
    line-height:1;
    color:#ffb703;
    text-shadow:0 2px 0 rgba(255,140,0,.25);
    animation:starIdle 2.4s ease-in-out infinite;
}

.quiz-star-count{
    font-size:30px;
    font-weight:700;
    color:#c77700;
    line-height:1;
    min-width:1.2em;
}

.quiz-star-label{
    font-size:13px;
    font-weight:600;
    letter-spacing:.04em;
    text-transform:uppercase;
    color:#a86b00;
}

.quiz-star-score.pop{
    animation:starScorePop .55s cubic-bezier(.2,.9,.25,1);
}

.quiz-star-score.pop .quiz-star-icon{
    animation:starBurst .55s ease;
}

.quiz-star-score.pop .quiz-star-count{
    animation:starCountBump .55s ease;
}

.quiz-star-score.star-celebration{
    box-shadow:0 0 0 5px rgba(255,214,10,.16),0 16px 36px rgba(255,183,3,.48);
}

.star-reward-flight{
    position:fixed;
    top:50%;
    left:50%;
    z-index:2500;
    display:flex;
    align-items:center;
    gap:12px;
    padding:18px 26px;
    border:3px solid #ffb703;
    border-radius:24px;
    background:linear-gradient(145deg,#fffdf0,#ffe08a);
    color:#a85f00;
    font-size:34px;
    line-height:1;
    box-shadow:0 16px 38px rgba(255,183,3,.45),0 0 0 8px rgba(255,214,10,.18);
    pointer-events:none;
    transform:translate(-50%,-50%) scale(1);
    animation:starRewardAppear .5s cubic-bezier(.2,.9,.25,1) both;
}

.star-reward-flight.is-flying{
    animation:starRewardFly .75s cubic-bezier(.55,.05,.2,1) forwards;
}

.star-reward-icon{
    color:#ffb703;
    font-size:58px;
    text-shadow:0 3px 0 #e58b00,0 0 16px rgba(255,183,3,.7);
    animation:starRewardIcon .5s ease-in-out infinite alternate;
}

.star-reward-flight strong{
    font-size:42px;
}

.quiz-star-float{
    position:absolute;
    top:50%;
    left:50%;
    transform:translate(-50%, -50%);
    font-size:22px;
    font-weight:700;
    color:#ff8a00;
    pointer-events:none;
    opacity:0;
    z-index:6;
    text-shadow:0 2px 8px rgba(255,183,3,.45);
    animation:starFloatUp .9s ease forwards;
}

.quiz-star-spark{
    position:absolute;
    top:50%;
    left:50%;
    width:7px;
    height:16px;
    border-radius:999px;
    background:#ffb703;
    box-shadow:0 0 10px rgba(255,183,3,.8);
    pointer-events:none;
    transform:rotate(var(--spark-angle)) translateY(-8px) scale(.2);
    animation:starSpark .65s cubic-bezier(.2,.8,.3,1) forwards;
}

.quiz-star-ring{
    position:absolute;
    top:50%;
    left:50%;
    width:100%;
    aspect-ratio:1;
    border:3px solid rgba(255,183,3,.72);
    border-radius:50%;
    pointer-events:none;
    transform:translate(-50%,-50%) scale(.4);
    animation:starRing .7s ease-out forwards;
}

.quiz-star-ray{
    position:absolute;
    top:50%;
    left:50%;
    width:5px;
    height:13px;
    border-radius:999px;
    background:#ff8a4c;
    pointer-events:none;
    transform:rotate(var(--ray-angle)) translateY(-24px) scaleY(.2);
    transform-origin:50% 24px;
    animation:starRay .7s cubic-bezier(.2,.8,.3,1) forwards;
}

@keyframes starIdle{
    0%,100%{ transform:rotate(-6deg) scale(1); }
    50%{ transform:rotate(6deg) scale(1.08); }
}

@keyframes starScorePop{
    0%{ transform:scale(1); }
    35%{ transform:scale(1.18) rotate(-2deg); }
    70%{ transform:scale(0.96) rotate(2deg); }
    100%{ transform:scale(1) rotate(0deg); }
}

@keyframes starBurst{
    0%{ transform:scale(1) rotate(0deg); filter:brightness(1); }
    40%{ transform:scale(1.45) rotate(-18deg); filter:brightness(1.25); }
    100%{ transform:scale(1) rotate(0deg); filter:brightness(1); }
}

@keyframes starCountBump{
    0%{ transform:scale(1); }
    40%{ transform:scale(1.35); color:#ff6b00; }
    100%{ transform:scale(1); }
}

@keyframes starFloatUp{
    0%{
        opacity:0;
        transform:translate(-50%, 8px) scale(.8);
    }
    20%{
        opacity:1;
        transform:translate(-50%, -10px) scale(1.15);
    }
    100%{
        opacity:0;
        transform:translate(-50%, -48px) scale(1);
    }
}

@keyframes starRewardAppear{
    0%{ opacity:0; transform:translate(-50%,-50%) scale(.35); }
    70%{ opacity:1; transform:translate(-50%,-50%) scale(1.12); }
    100%{ opacity:1; transform:translate(-50%,-50%) scale(1); }
}

@keyframes starRewardIcon{
    from{ transform:rotate(-10deg) scale(1); }
    to{ transform:rotate(10deg) scale(1.12); }
}

@keyframes starRewardFly{
    0%{ opacity:1; transform:translate(-50%,-50%) scale(1) rotate(0deg); }
    65%{ opacity:1; transform:translate(calc(-50% + var(--fly-x) * .72),calc(-50% + var(--fly-y) * .72)) scale(.7) rotate(250deg); }
    100%{ opacity:0; transform:translate(calc(-50% + var(--fly-x)),calc(-50% + var(--fly-y))) scale(.22) rotate(360deg); }
}

@keyframes starSpark{
    0%{ opacity:0; transform:rotate(var(--spark-angle)) translateY(-8px) scale(.2); }
    25%{ opacity:1; }
    100%{ opacity:0; transform:rotate(var(--spark-angle)) translateY(calc(var(--spark-distance) * -1)) scale(1); }
}

@keyframes starRing{
    0%{ opacity:.9; transform:translate(-50%,-50%) scale(.35); }
    100%{ opacity:0; transform:translate(-50%,-50%) scale(2.1); }
}

@keyframes starRay{
    0%{ opacity:0; transform:rotate(var(--ray-angle)) translateY(-22px) scaleY(.2); }
    25%{ opacity:1; }
    100%{ opacity:0; transform:rotate(var(--ray-angle)) translateY(-50px) scaleY(1); }
}

