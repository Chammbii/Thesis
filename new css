/* Toggle switch */
.switch{
    position:relative;
    display:inline-flex;
    width:56px;
    height:32px;
    flex-shrink:0;
    cursor:pointer;
}

.switch input{
    opacity:0;
    width:0;
    height:0;
    position:absolute;
}

.switch-track{
    position:absolute;
    inset:0;
    border-radius:999px;
    background:#cfd8e3;
    transition:background .25s ease, box-shadow .25s ease;
    box-shadow:inset 0 1px 3px rgba(0,0,0,.12);
}

.switch-track::after{
    content:"";
    position:absolute;
    top:3px;
    left:3px;
    width:26px;
    height:26px;
    border-radius:50%;
    background:#fff;
    box-shadow:0 3px 8px rgba(29,53,87,.2);
    transition:transform .25s cubic-bezier(.2,.9,.25,1);
}

.switch input:checked + .switch-track{
    background:linear-gradient(135deg,#57cc99,#38b000);
}

.switch input:focus-visible + .switch-track{
    outline:3px solid rgba(58,134,255,.45);
    outline-offset:2px;
}

.switch input:checked + .switch-track::after{
    transform:translateX(24px);
}

/* Range slider */
.setting-range{
    -webkit-appearance:none;
    appearance:none;
    width:100%;
    height:10px;
    border-radius:999px;
    background:linear-gradient(90deg,#8fd3ff,#ffb703);
    outline:none;
    cursor:pointer;
}

.setting-range::-webkit-slider-thumb{
    -webkit-appearance:none;
    appearance:none;
    width:24px;
    height:24px;
    border-radius:50%;
    border:3px solid #fff;
    background:linear-gradient(145deg,#ffb703,#ff8a4c);
    box-shadow:0 4px 12px rgba(255,138,76,.4);
    cursor:pointer;
    transition:transform .15s ease;
}

.setting-range::-moz-range-thumb{
    width:24px;
    height:24px;
    border-radius:50%;
    border:3px solid #fff;
    background:linear-gradient(145deg,#ffb703,#ff8a4c);
    box-shadow:0 4px 12px rgba(255,138,76,.4);
    cursor:pointer;
}

.setting-range:active::-webkit-slider-thumb{
    transform:scale(1.12);
}

