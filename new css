    #quizAnswerGrid[data-quiz-choice-layout="hard"] .answer-card{
        min-height:190px;
        max-width:260px;
        padding:14px;
    }

    .answer-image,
    #quizAnswerGrid[data-quiz-choice-layout="hard"] .answer-image{
        height:135px;
    }

    .quiz-star-score{
        min-width:128px;
        padding:12px 16px;
    }

    .quiz-star-icon{
        font-size:34px;
    }

    .quiz-star-count{
        font-size:30px;
    }
}

/* =====================================================
   PART 3B - QUIZ UPGRADE
===================================================== */

/* Quiz Information */

.quiz-info{

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin:20px 0;

    padding:18px 28px;

    background:#f4fbff;

    border-radius:18px;

    font-size:24px;

    font-weight:bold;

}

/* Category Badge */

.quiz-category{

    margin:20px auto;

}

#quizCategoryBadge{

    background:#6c5ce7;

    color:white;

    padding:12px 28px;

    border-radius:30px;

    font-size:22px;

    font-weight:bold;

}

/* Question Box */

.question-box{

    background:#fff9e6;

    border-radius:28px;

    padding:30px;

    margin:25px 0;

    box-shadow:0 10px 20px rgba(0,0,0,.08);

}

.question-box h1{

    color:#444;

    font-size:42px;

    line-height:1.45;

}

/* Optional Question Image */

.question-image{

    width:260px;

    height:260px;

    margin:20px auto;

    display:flex;

    justify-content:center;

    align-items:center;

    background:white;

    border-radius:25px;

    box-shadow:0 10px 25px rgba(0,0,0,.10);

}

.question-image img{

    max-width:180px;

    max-height:180px;

    object-fit:contain;

}

/* Answer Cards */

.answer-card{

    min-height:100px;

    display:flex;

    justify-content:center;

    align-items:center;

    font-size:26px;

    font-weight:bold;

    transition:.25s;

}

.answer-card:hover{

    transform:scale(1.05);

}

/* Correct */

.answer-card.correct{

    background:#2ecc71 !important;

    color:white;

    animation:correctAnswer .5s;

}

@keyframes correctAnswer{

    0%{

        transform:scale(.8);

    }

    50%{

        transform:scale(1.08);

    }

    100%{

        transform:scale(1);

    }

}

/* Wrong */

.answer-card.wrong{

    background:#e74c3c !important;

    color:white;

    animation:wrongAnswer .4s;

}

@keyframes wrongAnswer{

    0%{

        transform:translateX(-8px);

    }

    25%{

        transform:translateX(8px);

    }

    50%{

        transform:translateX(-8px);

    }

    75%{

        transform:translateX(8px);

    }

    100%{

        transform:translateX(0);

    }

}

/* Feedback */

.quiz-feedback{

    min-height:48px;

    margin-top:28px;

    font-size:36px;

    font-weight:bold;

    color:#ff9800;

}

/* Next Button */

.quiz-navigation{

    margin-top:35px;

}





/* ===========================
   RESULT SCREEN
=========================== */



.result-container{

    width:100%;

    max-width:700px;

    background:white;

    padding:45px;

    border-radius:30px;

    text-align:center;

    box-shadow:0 20px 40px rgba(0,0,0,.15);

}

.result-container h1{

    color:#ff6b6b;

    margin-bottom:15px;

}

.result-container p{

    color:#666;

    font-size:22px;

    margin-bottom:20px;

}

/* Stars */

.star-display{

    font-size:60px;

    margin:30px 0;

    animation:starsBounce 1s infinite alternate;

}

@keyframes starsBounce{

    from{

        transform:translateY(0);

    }

    to{

        transform:translateY(-10px);

    }

}

/* Final Score */




.final-score{

    margin:30px 0;

}

.final-score h2{

    color:#444;

}

#finalScore{

    color:#3a86ff;

    font-size:55px;

}




/* Performance */

.performance-message{

    font-size:24px;

    color:#ff9800;

    margin-bottom:30px;

}


.notification-box{

    position:fixed;

    left:50%;

    bottom:32px;

    transform:translateX(-50%) scale(0.96);

    background:rgba(255,255,255,0.96);

    border:2px solid rgba(255,183,3,0.35);

    border-radius:24px;

    padding:24px 32px;

    box-shadow:0 25px 60px rgba(0,0,0,0.2);

    color:#1d1d1d;

    font-size:22px;

    text-align:center;

    z-index:9999;

    opacity:0;

    visibility:hidden;

    transition:opacity 0.3s ease,transform 0.3s ease,visibility 0.3s ease;

    max-width:90%;

    pointer-events:none;

}

.notification-box.show{

    opacity:1;

    visibility:visible;

    transform:translateX(-50%) scale(1);

    pointer-events:auto;

}


.notification-box.hidden{

    opacity:0;

    visibility:hidden;

}



/* Result Buttons */




.result-buttons{

    display:flex;

    justify-content:center;

    gap:20px;

    flex-wrap:wrap;

}

.result-buttons .main-btn{

    width:230px;

}

/* Fade Animation */

.fade-in{

    animation:fadeIn .4s ease;

}

@keyframes fadeIn{

    from{

        opacity:0;

        transform:translateY(15px);

    }

    to{

        opacity:1;

        transform:translateY(0);

    }

}


/* Responsive */


@media(max-width:768px){

    .quiz-info{

        flex-direction:column;

        gap:10px;

    }

    .question-box h1{

        font-size:32px;

    }

    .question-image{

        width:210px;

        height:210px;

    }

    .question-image img{

        max-width:140px;

        max-height:140px;

    }

    .star-display{

        font-size:45px;

    }

    #finalScore{

        font-size:42px;

    }

    .performance-message{

        font-size:20px;

    }



}

