/* =====================================================
   QUIZLAND ADVENTURE
   STYLE.CSS
===================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Fredoka',sans-serif;
}

body{
    background:linear-gradient(135deg,#8fd3ff,#b7f7ff,#fff8b5);
    min-height:100vh;
    overflow-x:hidden;
    scrollbar-width:thin;
    scrollbar-color:#5bb8ff #e8f6ff;
}

.fun-background{
    position:fixed;
    inset:0;
    overflow:hidden;
    pointer-events:none;
    z-index:0;
}

.screen > *{
    position:relative;
    z-index:1;
}

.fun-cloud{
    position:absolute;
    width:150px;
    height:48px;
    border-radius:999px;
    background:rgba(255,255,255,.62);
    filter:drop-shadow(0 8px 8px rgba(58,134,255,.08));
    animation:fun-cloud-drift 18s linear infinite;
}

.fun-cloud::before,
.fun-cloud::after{
    content:"";
    position:absolute;
    bottom:12px;
    border-radius:50%;
    background:inherit;
}

.fun-cloud::before{left:28px;width:64px;height:64px;}
.fun-cloud::after{left:78px;width:48px;height:48px;}
.fun-cloud--one{top:13%;left:-180px;}
.fun-cloud--two{top:58%;left:-240px;animation-delay:-9s;transform:scale(.72);}
.fun-cloud--three{top:35%;left:-300px;animation-delay:-4s;transform:scale(.54);}
.fun-cloud--four{top:78%;left:-200px;animation-delay:-14s;transform:scale(.86);}

.fun-shape{
    position:absolute;
    opacity:.38;
    animation:fun-shape-bob 6s ease-in-out infinite;
}

.fun-shape--circle{
    right:8%;
    top:20%;
    width:32px;
    height:32px;
    border:7px solid #ffb703;
    border-radius:50%;
}

.fun-shape--star{right:14%;bottom:19%;color:#ff6b6b;font-size:34px;animation-delay:-2s;}
.fun-shape--diamond{left:10%;bottom:22%;width:28px;height:28px;background:#3a86ff;transform:rotate(45deg);animation-delay:-4s;}

@keyframes fun-cloud-drift{from{transform:translateX(0);}to{transform:translateX(calc(100vw + 420px));}}
@keyframes fun-shape-bob{
    0%,100%{margin-top:0;transform:rotate(0) scale(1);}
    50%{margin-top:-18px;transform:rotate(12deg) scale(1.12);}
}

body:has(#teacherDashboard.screen.active) .fun-background{
    display:none;
}

/* =====================================================
   CUSTOM SCROLLBAR (kid-friendly)
===================================================== */

*::-webkit-scrollbar{
    width:14px;
    height:14px;
}

*::-webkit-scrollbar-track{
    background:linear-gradient(180deg,#eaf7ff 0%,#fff8dc 100%);
    border-radius:999px;
    border:3px solid transparent;
    background-clip:padding-box;
    box-shadow:inset 0 0 0 1px rgba(58,134,255,.12);
}

*::-webkit-scrollbar-thumb{
    background:linear-gradient(180deg,#7ad0ff 0%,#4aa8ff 45%,#ffb703 100%);
    border-radius:999px;
    border:3px solid transparent;
    background-clip:padding-box;
    box-shadow:
        0 2px 8px rgba(58,134,255,.28),
        inset 0 1px 0 rgba(255,255,255,.55);
    min-height:48px;
}

*::-webkit-scrollbar-thumb:hover{
    background:linear-gradient(180deg,#9adcff 0%,#3a86ff 50%,#ff9f1c 100%);
    background-clip:padding-box;
    box-shadow:
        0 4px 12px rgba(58,134,255,.38),
        inset 0 1px 0 rgba(255,255,255,.7);
}

*::-webkit-scrollbar-thumb:active{
    background:linear-gradient(180deg,#3a86ff 0%,#2667d1 55%,#fb8500 100%);
    background-clip:padding-box;
}

*::-webkit-scrollbar-corner{
    background:transparent;
}

*::-webkit-scrollbar-button{
    display:none;
    width:0;
    height:0;
}

/* Softer scroll areas inside white panels */
.quiz-container,
.settings-panel,
.modal-content,
.tdash,
.quiz-history-table-wrap,
.teacher-progress-table,
.bar-chart{
    scrollbar-width:thin;
    scrollbar-color:#4aa8ff #eef7ff;
}

.quiz-container::-webkit-scrollbar-track,
.settings-panel::-webkit-scrollbar-track,
.modal-content::-webkit-scrollbar-track{
    background:linear-gradient(180deg,#f2f9ff,#fff6e8);
    border-radius:999px;
}

.quiz-container::-webkit-scrollbar-thumb,
.settings-panel::-webkit-scrollbar-thumb,
.modal-content::-webkit-scrollbar-thumb{
    background:linear-gradient(180deg,#6bc4ff,#3a86ff 55%,#ffb703);
    background-clip:padding-box;
}

/* =====================================================
   SCREENS
===================================================== */

.screen{
    display:none;
    min-height:100vh;
    justify-content:center;
    align-items:center;
    padding:24px;
}

.screen.active{
    display:flex;
}

/* =====================================================
   HOME
===================================================== */

#homeScreen{
    position:relative;
    isolation:isolate;
    overflow:hidden;
    background:
        radial-gradient(circle at 15% 15%,rgba(255,255,255,.8) 0 5%,transparent 24%),
        radial-gradient(circle at 88% 12%,rgba(255,255,255,.55) 0 4%,transparent 22%),
        linear-gradient(135deg,#75cfff 0%,#b7f7ff 42%,#fff3a8 100%);
}

#homeScreen::before{
    content:"";
    position:absolute;
    inset:-20%;
    z-index:-2;
    background:
        radial-gradient(ellipse at 30% 75%,rgba(255,255,255,.62) 0 8%,transparent 30%),
        radial-gradient(ellipse at 75% 55%,rgba(255,183,3,.18) 0 7%,transparent 28%);
    animation:home-cloud-drift 14s ease-in-out infinite alternate;
}

#homeScreen::after{
    content:"";
    position:absolute;
    left:-5%;
    right:-5%;
    bottom:-18%;
    height:43%;
    z-index:-1;
    border-radius:50% 50% 0 0;
    background:linear-gradient(180deg,rgba(255,255,255,.58),rgba(255,255,255,.15));
    box-shadow:0 -16px 50px rgba(255,255,255,.28);
    animation:home-wave 8s ease-in-out infinite alternate;
}

.home-container{
    position:relative;
    z-index:2;
    width:100%;
    max-width:650px;
    padding:46px 42px 42px;
    border:1px solid rgba(255,255,255,.72);
    border-radius:34px;
    background:rgba(255,255,255,.54);
    box-shadow:0 24px 55px rgba(29,53,87,.16),inset 0 1px 0 rgba(255,255,255,.8);
    backdrop-filter:blur(8px);
    text-align:center;
    animation:home-card-float 5s ease-in-out infinite;
}

.home-badge{
    display:inline-flex;
    align-items:center;
    gap:7px;
    padding:8px 14px;
    border-radius:999px;
    background:rgba(255,255,255,.78);
    color:#1d4f9c;
    font-size:14px;
    font-weight:800;
    box-shadow:0 7px 16px rgba(58,134,255,.12);
}

.home-badge span{
    color:#ffb703;
    font-size:18px;
}

#homeScreen .subtitle{
    margin:18px 0 26px;
    color:#1d3557;
    font-size:25px;
    font-weight:700;
    letter-spacing:.02em;
}

#homeScreen .subtitle span{
    color:#ff9f1c;
    padding:0 5px;
}

.home-orbit{
    position:absolute;
    border:2px dashed rgba(255,255,255,.58);
    border-radius:50%;
    pointer-events:none;
    z-index:0;
}

.home-orbit--one{
    width:420px;
    height:420px;
    top:-180px;
    right:-120px;
    animation:home-orbit-spin 22s linear infinite;
}

.home-orbit--two{
    width:280px;
    height:280px;
    bottom:-120px;
    left:-80px;
    border-color:rgba(58,134,255,.18);
    animation:home-orbit-spin 18s linear infinite reverse;
}

.home-bubble{
    position:absolute;
    border-radius:50%;
    pointer-events:none;
    z-index:1;
    opacity:.8;
    animation:home-bubble-float 6s ease-in-out infinite;
}

.home-bubble--one{
    width:34px;
    height:34px;
    top:22%;
    left:14%;
    background:#ffb703;
    box-shadow:0 8px 18px rgba(255,183,3,.3);
}

.home-bubble--two{
    width:22px;
    height:22px;
    right:17%;
    bottom:25%;
    background:#ff6b6b;
    animation-delay:-2s;
}

.home-bubble--three{
    width:17px;
    height:17px;
    top:34%;
    right:11%;
    background:#3a86ff;
    animation-delay:-4s;
}

.home-sparkles{
    position:absolute;
    inset:0;
    pointer-events:none;
    z-index:1;
    color:#fff;
    font-size:28px;
    text-shadow:0 3px 10px rgba(58,134,255,.28);
}

.home-sparkles span{
    position:absolute;
    animation:home-sparkle 2.4s ease-in-out infinite;
}

.home-sparkles span:nth-child(1){top:18%;left:30%;}
.home-sparkles span:nth-child(2){top:27%;right:25%;animation-delay:.6s;}
.home-sparkles span:nth-child(3){bottom:20%;left:24%;animation-delay:1.2s;color:#ffb703;}
.home-sparkles span:nth-child(4){bottom:30%;right:31%;animation-delay:1.8s;}

#homeScreen .main-btn{
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-wrap:wrap;
    gap:10px;
    min-height:76px;
    padding:14px 24px;
    border:2px solid rgba(255,255,255,.55);
    border-radius:22px;
    background:linear-gradient(135deg,#ffb703 0%,#ff8a4c 52%,#ff6b6b 100%);
    box-shadow:0 14px 25px rgba(255,126,45,.3),0 0 0 0 rgba(255,183,3,.45);
    overflow:hidden;
    animation:home-button-pulse 2.6s ease-in-out infinite;
}

#homeScreen .main-btn::before{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(110deg,transparent 25%,rgba(255,255,255,.5) 48%,transparent 70%);
    transform:translateX(-120%);
    animation:home-button-shine 3.5s ease-in-out infinite;
}

#homeScreen .main-btn i,
#homeScreen .main-btn span,
#homeScreen .main-btn small{
    position:relative;
    z-index:1;
}

#homeScreen .main-btn small{
    display:block;
    flex-basis:100%;
    margin-top:-8px;
    font-size:12px;
    font-weight:600;
    opacity:.9;
}

#homeScreen .main-btn:hover{
    transform:translateY(-6px) scale(1.03);
    background:linear-gradient(135deg,#ffc928 0%,#ff9f1c 52%,#ff6b6b 100%);
    box-shadow:0 18px 32px rgba(255,126,45,.38),0 0 0 8px rgba(255,183,3,.12);
}

@keyframes home-card-float{0%,100%{transform:translateY(0);}50%{transform:translateY(-7px);}}
@keyframes home-cloud-drift{from{transform:translate3d(-2%,0,0) scale(1);}to{transform:translate3d(3%,-2%,0) scale(1.06);}}
@keyframes home-wave{from{transform:translateX(-2%) rotate(-1deg);}to{transform:translateX(2%) rotate(1deg);}}
@keyframes home-orbit-spin{to{transform:rotate(360deg);}}
@keyframes home-bubble-float{0%,100%{transform:translateY(0) scale(1);}50%{transform:translateY(-18px) scale(1.12);}}
@keyframes home-sparkle{0%,100%{opacity:.3;transform:scale(.75) rotate(0);}50%{opacity:1;transform:scale(1.2) rotate(18deg);}}
@keyframes home-button-pulse{0%,100%{box-shadow:0 14px 25px rgba(255,126,45,.3),0 0 0 0 rgba(255,183,3,.35);}50%{box-shadow:0 17px 30px rgba(255,126,45,.38),0 0 0 10px rgba(255,183,3,0);}}
@keyframes home-button-shine{0%,55%{transform:translateX(-120%);}78%,100%{transform:translateX(120%);}}

@media(prefers-reduced-motion:reduce){
    #homeScreen *,
    #homeScreen::before,
    #homeScreen::after{animation:none !important;}
}



h1{
    font-size:52px;
    color:#ff6b6b;
    margin-bottom:10px;
}

.subtitle{
    font-size:22px;
    color:#555;
    margin-bottom:25px;
}



/* =====================================================
   BUTTONS
===================================================== */

.button-group{
    display:flex;
    flex-direction:column;
    gap:20px;
}

.main-btn{

    width:100%;
    padding:18px;

    border:none;
    border-radius:18px;

    background:#ffb703;
    color:white;

    font-size:22px;
    font-weight:bold;

    cursor:pointer;

    transition:.3s;
}

#teacherSubmitBtn{
    background:#2ecc71;
}

#teacherSubmitBtn:hover{
    background:#27ae60;
}

.main-btn:hover{

    transform:translateY(-5px);

    background:#fb8500;

    box-shadow:0 10px 25px rgba(0,0,0,.20);
}

.main-btn i{

    margin-right:10px;
}

/* =====================================================
   PROFILE
===================================================== */

.profile-container{

    width:100%;
    max-width:700px;

    background:white;

    border-radius:30px;

    padding:40px;

    text-align:center;

    box-shadow:0 20px 45px rgba(0,0,0,.15);
}

.teacher-container{

    width:100%;
    max-width:700px;
    text-align:center;
}

.teacher-card{

    background:rgba(255,255,255,0.95);
    border-radius:30px;
    padding:40px;
    box-shadow:0 25px 50px rgba(0,0,0,.15);
    border:1px solid rgba(58, 134, 255, 0.15);
}

.teacher-card h2{
    color:#1d3557;
    margin-bottom:10px;
}

.teacher-card p{
    color:#556680;
    margin-bottom:25px;
    font-size:18px;
}

.teacher-form{
    display:flex;
    flex-direction:column;
    gap:18px;
}

.teacher-form-actions{
    display:flex;
    flex-direction:column;
    gap:12px;
}

.input-wrapper{
    position:relative;
    width:100%;
}

.input-wrapper input{
    width:100%;
    padding:18px 60px 18px 18px;
    border-radius:16px;
    border:2px solid #d8e9ff;
    font-size:18px;
    outline:none;
    transition:all 0.3s ease;
}

.password-toggle-btn{
    position:absolute;
    right:12px;
    top:50%;
    transform:translateY(-50%);
    border:none;
    background:transparent;
    color:#2463eb;
    font-size:14px;
    font-weight:700;
    cursor:pointer;
    padding:6px 8px;
    border-radius:8px;
    z-index:2;
}

.password-toggle-btn:hover{
    background:rgba(36, 99, 235, 0.08);
}

.input-wrapper input:focus{
    border-color:#3a86ff;
    box-shadow:0 0 0 3px rgba(58, 134, 255, 0.1);
}

.input-error-icon{
    position:absolute;
    right:16px;
    top:50%;
    transform:translateY(-50%);
    color:#e63946;
    font-size:20px;
    display:none;
    pointer-events:none;
}

.input-error-message{
    position:absolute;
    top:50%;
    left:18px;
    transform:translateY(-50%);
    background:linear-gradient(135deg, #e63946, #d62828);
    color:white;
    padding:6px 12px;
    border-radius:8px;
    font-size:14px;
    font-weight:600;
    white-space:nowrap;
    opacity:0;
    pointer-events:none;
    transition:opacity 0.3s ease;
    z-index:10;
    box-shadow:0 4px 12px rgba(230, 57, 70, 0.3);
}

.input-wrapper.error input{
    border-color:#e63946;
    background-color:rgba(230, 57, 70, 0.05);
}

.input-wrapper.error .input-error-icon{
    display:block;
}

.input-wrapper.error .input-error-message{
    opacity:1;
    left:18px;
}

.teacher-form input{
    width:100%;
    padding:18px;
    border-radius:16px;
    border:2px solid #d8e9ff;
    font-size:18px;
    outline:none;
}

.teacher-hidden{
    display:none !important;
}

.teacher-switch{
    display:flex;
    flex-direction:column;
    align-items:stretch;
    gap:10px;
    margin:0;
}

.teacher-switch span{
    color:#556680;
    font-size:16px;
    text-align:center;
}

.secondary-btn{
    width:100%;
    padding:14px 18px;
    border:none;
    border-radius:16px;
    background:#eaf3ff;
    color:#1d3557;
    font-size:18px;
    font-weight:700;
    cursor:pointer;
    transition:all 0.25s ease;
}

.secondary-btn:hover{
    background:#dfeeff;
    transform:translateY(-2px);
}

.teacher-form .back-btn{
    margin-top:4px;
}

.teacher-form--unlock{
    gap:20px;
}

.teacher-form--unlock #teacherSubmitBtn{
    margin-top:4px;
}

.teacher-form--unlock .back-btn{
    margin-top:8px;
}

.teacher-progress-panel{
    margin-top:30px;
    text-align:left;
}

/* =====================================================
   TEACHER DASHBOARD (ENHANCED)
===================================================== */

#teacherDashboard.screen.active{
    align-items:flex-start;
    padding:0;
}

.tdash{
    width:100%;
    max-width:none;
    margin:0;
    display:grid;
    grid-template-columns:260px minmax(0,1fr);
    min-height:100vh;
    gap:0;
}

.teacher-sidebar{
    position:sticky;
    top:0;
    height:100vh;
    display:flex;
    flex-direction:column;
    padding:28px 16px 20px;
    background:linear-gradient(180deg,#1d3557 0%,#243f68 55%,#19304f 100%);
    color:#fff;
    box-shadow:10px 0 28px rgba(29,53,87,.16);
    overflow-y:auto;
    overscroll-behavior:contain;
    z-index:5;
    transition:width .28s ease, transform .28s ease, padding .28s ease;
}

.teacher-sidebar-brand{
    display:flex;
    align-items:center;
    gap:12px;
    padding:0 10px 30px;
}

.teacher-sidebar-logo,
.teacher-sidebar-avatar{
    display:grid;
    place-items:center;
    flex:0 0 auto;
    width:42px;
    height:42px;
    border-radius:14px;
    background:linear-gradient(135deg,#ffb703,#ff8a4c);
    color:#fff;
    font-weight:900;
    box-shadow:0 8px 18px rgba(255,183,3,.25);
