<!DOCTYPE html>
<!-- <html lang="en"> -->

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#1d3557">
    <meta name="screen-orientation" content="landscape">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="QuizLand">
    <link rel="manifest" href="manifest.webmanifest">
    <link rel="apple-touch-icon" href="icon-192.png">

    <title>QuizLand</title>

      <!-- Favicon / Tab Logo -->
  <link rel="icon" type="image/png" class = logo  href="logo.png">


    <!-- CSS -->
    <link rel="stylesheet" href="style.css">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="supabase-config.js"></script>

        <audio id="popSound" src="popclick.mp3" preload="auto"></audio>
<!-- bg audio -->
        <audio id="bgMusic" loop autoplay preload="auto" src="bgMusic.mp3"></audio>


   
</head>

<body>  

    <div class="fun-background" aria-hidden="true">
        <span class="fun-cloud fun-cloud--one"></span>
        <span class="fun-cloud fun-cloud--two"></span>
        <span class="fun-cloud fun-cloud--three"></span>
        <span class="fun-cloud fun-cloud--four"></span>
        <span class="fun-shape fun-shape--circle"></span>
        <span class="fun-shape fun-shape--star">★</span>
        <span class="fun-shape fun-shape--diamond"></span>
    </div>

    <div id="portraitOrientationNotice" class="portrait-orientation-notice" role="alert">
        <div class="portrait-orientation-card">
            <span class="portrait-orientation-icon" aria-hidden="true">↔</span>
            <h2>Turn your device sideways</h2>
            <p>QuizLand works in landscape mode. Rotate your phone or tablet to continue playing.</p>
        </div>
    </div>

    <!-- ===================================================== -->
    <!-- HOME SCREEN -->
    <!-- ===================================================== -->

    <section id="homeScreen" class="screen active">

        <div class="home-orbit home-orbit--one" aria-hidden="true"></div>
        <div class="home-orbit home-orbit--two" aria-hidden="true"></div>
        <div class="home-bubble home-bubble--one" aria-hidden="true"></div>
        <div class="home-bubble home-bubble--two" aria-hidden="true"></div>
        <div class="home-bubble home-bubble--three" aria-hidden="true"></div>
        <div class="home-sparkles" aria-hidden="true"><span>✦</span><span>✧</span><span>✦</span><span>✧</span></div>

        <div class="home-container">

            <div class="home-badge"><span>★</span> A happy place to learn</div>
            <p class="subtitle">
                Learn <span>•</span> Play <span>•</span> Earn Stars
            </p>

            <div class="button-group">

                <button id="startBtn" class="main-btn">
                    <i class="fa-solid fa-play"></i>
                    <span>Start Learning</span>
                    <small>Begin your fun adventure</small>
                </button>

            </div>

        </div>

        <button type="button" id="teacherBtn" class="floating-teacher-btn" aria-label="Teacher login" title="Teacher login">
            <i class="fa-solid fa-user-tie"></i>
        </button>

        <button type="button" id="settingsBtn" class="floating-settings-btn" aria-label="Open settings" title="Settings">
            <i class="fa-solid fa-gear"></i>
        </button>

    </section>



    <!-- LESSON SCREEN -->
    <!-- STUDENT PROFILE -->
    <!-- ===================================================== -->

    <section id="profileScreen" class="screen">

        <div class="profile-container">

            <h2>Student Profile</h2>

            <p>
                Enter your details and choose your favorite avatar.
            </p>

            <label for="studentClassroomCode">Classroom Code</label>
            <input type="text" id="studentClassroomCode" placeholder="Enter 6-digit classroom code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="off">

            <label for="studentName">Full Name</label>
            <input type="text" id="studentName" placeholder="Enter your full name" autocomplete="name">

            <label for="studentGender">Gender</label>
            <select id="studentGender">
                <option value="">Select gender</option>
                <option value="male">Male</option>
                <option value="female">Female</option>
            </select>

            <h3>Select Avatar</h3>

            <div class="avatar-grid">

                <div class="avatar-card">
                    <img src="avatar001.png">
                </div>

                <div class="avatar-card">
                    <img src="avatar002.png">
                </div>

                <div class="avatar-card">
                    <img src="avatar003.png">
                </div>

                <div class="avatar-card">
                    <img src="avatar004.png">
                </div>

            </div>

            <button id="continueBtn" class="main-btn">
                Continue
            </button>

            <p id="profileApprovalStatus" class="profile-approval-status" aria-live="polite" hidden></p>

            <button type="button" id="profileBackHome" class="back-btn">
                ← Back to Home
            </button>

        </div>

    </section>


    <!-- ===================================================== -->
    <!-- TEACHER LOGIN SCREEN -->
    <!-- ===================================================== -->

    <section id="teacherScreen" class="screen">

        <div class="teacher-container">

            <div class="teacher-card">

                <h2 id="teacherFormTitle">Teacher Login</h2>

                <p id="teacherFormSubtitle">Enter your teacher credentials to access the dashboard.</p>

                <form id="teacherLoginForm" class="teacher-form">

                    <div class="input-wrapper">
                        <input type="email" id="teacherEmail" placeholder="Email">
                        <span class="input-error-icon" aria-hidden="true">⚠</span>
                        <div class="input-error-message"></div>
                    </div>

                    <div class="input-wrapper">
                        <input type="password" id="teacherPassword" placeholder="Password">
                        <button type="button" class="password-toggle-btn" data-toggle-target="teacherPassword" aria-label="Show password">Show</button>
                        <span class="input-error-icon" aria-hidden="true">⚠</span>
                        <div class="input-error-message"></div>
                    </div>

                    <div class="input-wrapper teacher-hidden">
                        <input type="password" id="teacherConfirmPassword" placeholder="Confirm Password">
                        <button type="button" class="password-toggle-btn" data-toggle-target="teacherConfirmPassword" aria-label="Show password">Show</button>
                        <span class="input-error-icon" aria-hidden="true">⚠</span>
                        <div class="input-error-message"></div>
                    </div>

                    <div class="input-wrapper teacher-hidden">
                        <input type="text" id="teacherFullName" placeholder="Full Name">
                        <span class="input-error-icon" aria-hidden="true">⚠</span>
                        <div class="input-error-message"></div>
                    </div>

                    <div class="teacher-form-actions">
                        <button type="submit" class="main-btn" id="teacherSubmitBtn">Login</button>
                        <button type="button" id="teacherForgotPasswordBtn" class="secondary-btn teacher-hidden">Forgot Password</button>
                        <button type="button" id="teacherLogoutUnlockBtn" class="secondary-btn teacher-hidden">Logout</button>
                    </div>

                    <p class="teacher-switch">
                        <span id="teacherSwitchText">Don't have an account?</span>
                        <button type="button" id="teacherToggleMode" class="main-btn">Register</button>
                    </p>

                    <button type="button" id="teacherBackHome" class="back-btn">← Back to Home</button>

                </form>

            </div>

        </div>

    </section>


    <section id="teacherDashboard" class="screen">

        <div class="tdash">

            <aside id="teacherSidebar" class="teacher-sidebar">
                <div class="teacher-sidebar-brand">
                    <span class="teacher-sidebar-logo">Q</span>
                    <div class="teacher-sidebar-brand-copy">
                        <strong>QuizLand</strong>
                        <span>Teacher portal</span>
                    </div>
                </div>
                <nav class="teacher-sidebar-nav" aria-label="Teacher dashboard actions">
                    <div id="teacherClassroomCode" class="teacher-classroom-code" aria-label="Classroom code">
                        <span class="teacher-sidebar-icon">#</span>
                        <span class="teacher-sidebar-label">
                            <small>Classroom code</small>
                            <b>------</b>
                        </span>
                    </div>
                    <button id="teacherDashboardRefreshBtn" class="teacher-sidebar-btn teacher-sidebar-btn--refresh" type="button"><span class="teacher-sidebar-icon">↻</span><span class="teacher-sidebar-label">Refresh</span></button>
                    <button id="teacherNotificationsBtn" class="teacher-sidebar-btn teacher-sidebar-btn--notifications" type="button"><span class="teacher-sidebar-icon">🔔</span><span class="teacher-sidebar-label">Notifications</span><span id="teacherNotificationBadge" class="teacher-notification-badge" hidden>0</span></button>
                    <button id="teacherCustomizeBtn" class="teacher-sidebar-btn" type="button"><span class="teacher-sidebar-icon">✦</span><span class="teacher-sidebar-label">Add Quiz</span></button>
                    <button id="teacherAddLessonBtn" class="teacher-sidebar-btn teacher-sidebar-btn--accent" type="button"><span class="teacher-sidebar-icon">＋</span><span class="teacher-sidebar-label">Add Lesson</span></button>
                    <button id="teacherDashboardPrintBtn" class="teacher-sidebar-btn" type="button"><span class="teacher-sidebar-icon">▣</span><span class="teacher-sidebar-label">Print</span></button>
                    <button id="teacherDashboardSettingsBtn" class="teacher-sidebar-btn" type="button"><span class="teacher-sidebar-icon">⚙</span><span class="teacher-sidebar-label">Settings</span></button>
                    <button id="teacherDashboardHomeBtn" class="teacher-sidebar-btn" type="button"><span class="teacher-sidebar-icon">⌂</span><span class="teacher-sidebar-label">Home</span></button>
                </nav>
                <div class="teacher-sidebar-account">
                    <div class="teacher-sidebar-user">
                        <span class="teacher-sidebar-avatar">★</span>
                        <span class="teacher-sidebar-label"><strong id="teacherSidebarName">Teacher</strong><small>Signed in</small></span>
                    </div>
                    <button id="teacherLogoutBtn" class="tdash-btn tdash-btn--solid" type="button">Logout</button>
                </div>
            </aside>

            <main class="tdash-main">
                <button id="teacherSidebarToggle" class="teacher-sidebar-toggle" type="button" aria-controls="teacherSidebar" aria-expanded="true" aria-label="Hide sidebar" title="Hide sidebar">☰</button>
                <header class="tdash-header">
                    <div class="tdash-header-copy">
                        <p class="tdash-eyebrow">QuizLand Teacher</p>
                        <h2>Classroom Dashboard</h2>
                        <p class="tdash-welcome">Welcome back, <span id="teacherNameDisplay">Teacher</span>.</p>
                    </div>
                </header>

            <div class="tdash-charts">
                <section class="tdash-panel">
                    <div class="tdash-panel-head">
                        <h3>Progress of Student</h3>
                        <p>Lesson category completion (%)</p>
                    </div>
                    <div id="teacherProgressChart" class="bar-chart" aria-label="Student progress bar chart"></div>
                </section>
                <section class="tdash-panel">
                    <div class="tdash-panel-head">
                        <h3>Stars of Student</h3>
                        <p>Total stars each child earned</p>
                    </div>
                    <div id="teacherStarsChart" class="bar-chart" aria-label="Student stars bar chart"></div>
                </section>
            </div>

            <section class="tdash-panel tdash-panel--wide">
                <div class="tdash-panel-head">
                    <h3>Stars earned of the day</h3>
                    <p>Total stars all students earned each day (last 14 days)</p>
                </div>
                <div id="teacherDailyStarsChart" class="bar-chart bar-chart--daily" aria-label="Daily stars earned bar chart"></div>
            </section>

            <section class="tdash-panel tdash-panel--wide">
                <div class="tdash-panel-head">
                    <h3>Student that needs more practice</h3>

                </div>
                <div id="teacherNeedsInterpretation" class="teacher-needs-interpretation" aria-live="polite"></div>
            </section>

            <section class="tdash-panel tdash-panel--wide">
                <div class="tdash-panel-head">
                    <h3>Student Progress Tracker</h3>
                    <p>Name, avatar, progress, accuracy, stars, and quiz history</p>
                    <p id="teacherStudentTrackerCount" class="teacher-student-count" aria-live="polite">0 students tracked</p>
                    <label class="teacher-student-sort-label" for="teacherStudentSort">Sort students</label>
                    <select id="teacherStudentSort" class="teacher-student-sort">
                        <option value="recent">Recently updated</option>
                        <option value="surname">Surname A-Z</option>
                        <option value="stars">Highest stars</option>
                    </select>
                    <label class="teacher-student-sort-label" for="teacherStudentGenderFilter">Show gender</label>
                    <select id="teacherStudentGenderFilter" class="teacher-student-sort">
                        <option value="all">All students</option>
                        <option value="male">Male students</option>
                        <option value="female">Female students</option>
                    </select>
                </div>
                <div class="teacher-progress-table">
                    <table id="teacherStudentProgressTable">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Avatar</th>
                                <th>Gender</th>
                                <th>Progress</th>
                                <th>Latest Activity Score</th>
                                <th>Stars</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </section>

            <section class="tdash-panel tdash-panel--wide" id="quizHistoryPanel">
                <div class="tdash-panel-head">
                    <h3>Quiz History</h3>
                    <p id="quizHistorySubtitle">Select a student to view every quiz attempt.</p>
                </div>
                <div class="quiz-history-table-wrap">
                    <table id="teacherQuizHistoryTable">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Category</th>
                                <th>Score</th>
                                <th>Accuracy</th>
                                <th>Stars Gained</th>
                                <th>Level Stopped</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="quiz-history-empty">
                                <td colspan="6">No student selected yet.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="tdash-panel tdash-panel--wide" id="activityLogPanel">
                <div class="tdash-panel-head">
                    <h3>Activity Log</h3>
                    <p id="activityLogSubtitle">Select a student to view recent learning activity.</p>
                </div>
                <div class="quiz-history-table-wrap">
                    <table id="teacherActivityLogTable">
                        <thead>
                            <tr>
                                <th>Date &amp; time</th>
                                <th>Activity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="quiz-history-empty">
                                <td colspan="2">No student selected yet.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            </main>
        </div>

        <div id="teacherTutorial" class="teacher-tutorial" hidden>
            <div class="teacher-tutorial-backdrop"></div>
            <div class="teacher-tutorial-card" role="dialog" aria-modal="true" aria-labelledby="teacherTutorialTitle">
                <div class="teacher-tutorial-progress" aria-hidden="true">
                    <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
                </div>
                <p class="teacher-tutorial-eyebrow">Quick dashboard tour</p>
                <h3 id="teacherTutorialTitle"></h3>
                <p id="teacherTutorialDescription"></p>
                <p id="teacherTutorialKeyboardHelp" class="teacher-tutorial-keyboard-help">Use ← and → on your keyboard to move between steps.</p>
                <div class="teacher-tutorial-actions">
                    <button id="teacherTutorialSkipBtn" class="tdash-btn tdash-btn--ghost" type="button">Skip tutorial</button>
                    <div class="teacher-tutorial-navigation">
                        <button id="teacherTutorialBackBtn" class="tdash-btn tdash-btn--ghost" type="button">Back</button>
                        <button id="teacherTutorialNextBtn" class="tdash-btn tdash-btn--solid" type="button">Next</button>
                    </div>
                </div>
                <label class="teacher-tutorial-preference">
                    <input id="teacherTutorialDontShowAgain" type="checkbox">
                    Do not show again
                </label>
            </div>
        </div>

        <div id="teacherPrintModal" class="teacher-print-modal" hidden>
            <div class="teacher-print-card" role="dialog" aria-modal="true" aria-labelledby="teacherPrintTitle">
                <h3 id="teacherPrintTitle">Print Student Progress</h3>
                <label for="teacherPrintStudent">Choose a student</label>
                <select id="teacherPrintStudent">
                    <option value="all">All students</option>
                </select>
                <div class="teacher-print-actions">
                    <button id="teacherPrintCancelBtn" class="tdash-btn tdash-btn--ghost" type="button">Cancel</button>
                    <button id="teacherPrintConfirmBtn" class="tdash-btn tdash-btn--solid" type="button">Print Progress</button>
                </div>
            </div>
        </div>

        <section id="teacherPrintReport" class="teacher-print-report" aria-hidden="true"></section>

        <div id="teacherCustomizeModal" class="teacher-customize-modal" hidden>
            <div class="teacher-customize-card" role="dialog" aria-modal="true" aria-labelledby="teacherCustomizeTitle">
                <h3 id="teacherCustomizeTitle">Add a Quiz Question</h3>
                <form id="teacherCustomizeForm" class="teacher-customize-form">
                    <label for="customQuestionCategory">Category</label>
                    <select id="customQuestionCategory" required>
                        <option value="alphabet">Alphabet</option>
                        <option value="numbers">Numbers</option>
                        <option value="colors">Colors</option>
                        <option value="shapes">Shapes</option>
                    </select>
                    <label for="customQuestionDifficulty">Level</label>
                    <select id="customQuestionDifficulty" required>
                        <option value="easy">Easy</option>
                        <option value="medium">Normal</option>
                        <option value="hard">Hard</option>
                    </select>
                    <label for="customQuestionPrompt">Question</label>
                    <input id="customQuestionPrompt" type="text" maxlength="160" placeholder="Which answer is correct?" required>
                    <label for="customQuestionCorrect">Correct answer</label>
                    <input id="customQuestionCorrect" type="text" maxlength="80" placeholder="Correct answer" required>
                    <label>Multiple-choice answers</label>
                    <div class="custom-choice-fields">
                        <div class="custom-choice-field">
                            <input class="custom-choice" type="text" maxlength="80" placeholder="Answer 1" required>
                            <input class="custom-choice-image" type="file" accept="image/*" aria-label="Photo for answer 1">
                        </div>
                        <div class="custom-choice-field">
                            <input class="custom-choice" type="text" maxlength="80" placeholder="Answer 2" required>
                            <input class="custom-choice-image" type="file" accept="image/*" aria-label="Photo for answer 2">
                        </div>
                        <div class="custom-choice-field">
                            <input class="custom-choice" type="text" maxlength="80" placeholder="Answer 3" required>
                            <input class="custom-choice-image" type="file" accept="image/*" aria-label="Photo for answer 3">
                        </div>
                    </div>
                    <p id="customQuestionMessage" class="teacher-customize-message" aria-live="polite"></p>
                    <div class="teacher-customize-actions">
                        <button id="teacherCustomizeCloseBtn" class="tdash-btn tdash-btn--ghost" type="button">Close</button>
                        <button class="tdash-btn tdash-btn--solid" type="submit">Save Question</button>
                    </div>
                </form>
                <div>
                    <h4>Your Added Quiz Questions</h4>
                    <div id="customQuestionList" class="custom-question-list"></div>
                </div>
            </div>
        </div>

        <div id="teacherLessonModal" class="teacher-customize-modal" hidden>
            <div class="teacher-customize-card teacher-lesson-card" role="dialog" aria-modal="true" aria-labelledby="teacherLessonTitle">
                <h3 id="teacherLessonTitle">Add a Lesson</h3>
                <p class="teacher-lesson-help">Create a lesson such as Animals. Add a cover picture, then add each animal picture and its name.</p>
                <form id="teacherLessonForm" class="teacher-customize-form">
                    <label for="customLessonName">Lesson name</label>
                    <input id="customLessonName" type="text" maxlength="50" placeholder="Animals" required>
                    <label for="customLessonCover">Cover picture</label>
                    <input id="customLessonCover" type="file" accept="image/*" required>
                    <div class="teacher-lesson-items-head">
                        <label>Lesson pictures and names</label>
                        <button id="addLessonItemBtn" class="tdash-btn tdash-btn--soft" type="button">Add picture</button>
                    </div>
                    <div id="customLessonItems" class="custom-lesson-items"></div>
                    <p id="teacherLessonMessage" class="teacher-customize-message" aria-live="polite"></p>
                    <div class="teacher-customize-actions">
                        <button id="teacherLessonCloseBtn" class="tdash-btn tdash-btn--ghost" type="button">Close</button>
                        <button class="tdash-btn tdash-btn--solid" type="submit">Save Lesson</button>
                    </div>
                </form>
                <div>
                    <h4>Your Added Lessons</h4>
                    <div id="customLessonList" class="custom-question-list"></div>
                </div>
            </div>
        </div>

        <div id="teacherNotificationsModal" class="teacher-customize-modal" hidden>
            <div class="teacher-customize-card teacher-notifications-card" role="dialog" aria-modal="true" aria-labelledby="teacherNotificationsTitle">
                <h3 id="teacherNotificationsTitle">Student Requests</h3>
                <p class="teacher-lesson-help">Review students before they can enter the learning menu.</p>
                <div id="teacherNotificationsList" class="teacher-notifications-list"></div>
                <div class="teacher-customize-actions">
                    <button id="teacherNotificationsCloseBtn" class="tdash-btn tdash-btn--ghost" type="button">Close</button>
                </div>
            </div>
        </div>

    </section>


    <!-- ===================================================== -->
    <!-- LEARNING MENU -->
    <!-- ===================================================== -->

    <section id="menuScreen" class="screen">

        <div class="menu-container">

            <h2>Choose What You Want To Learn</h2>

            <div class="lesson-grid">

                <!-- Alphabet -->

                <div class="lesson-card">

                    <img src="alphabetlesson.png">

                    <h3>Alphabet</h3>

                    <button class="lesson-btn">
                        Start
                    </button>
                    <button class="quiz-menu-btn" data-quiz-category="alphabet" type="button" disabled>
                        Quiz 🔒
                    </button>

                </div>

                <!-- Numbers -->

                <div class="lesson-card">

                    <img src="numberlesson.png">

                    <h3>Numbers</h3>

                    <button class="lesson-btn">
                        Start
                    </button>
                    <button class="quiz-menu-btn" data-quiz-category="numbers" type="button" disabled>
                        Quiz 🔒
                    </button>

                </div>

                <!-- Colors -->

                <div class="lesson-card">

                    <img src="colorlesson.png">

                    <h3>Colors</h3>

                    <button class="lesson-btn">
                        Start
                    </button>
                    <button class="quiz-menu-btn" data-quiz-category="colors" type="button" disabled>
                        Quiz 🔒
                    </button>

                </div>

                <!-- Shapes -->

                <div class="lesson-card">

                    <img src="shapelesson.png">

                    <h3>Shapes</h3>

                    <button class="lesson-btn">
                        Start
                    </button>
                    <button class="quiz-menu-btn" data-quiz-category="shapes" type="button" disabled>
                        Quiz 🔒
                    </button>

                </div>

                <div id="customLessonGrid" class="custom-lesson-grid"></div>

            </div>

            <button id="backHome" class="back-btn">
                ← Back to Home
            </button>

        </div>

    </section>



    <!-- ===================================================== -->
    <!-- SETTINGS POPUP -->
    <!-- ===================================================== -->

    <div id="settingsModal" class="modal">

        <div class="modal-content settings-panel">

            <button type="button" class="settings-close" id="settingsCloseBtn" aria-label="Close settings">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <header class="settings-header">
                <div class="settings-header-icon" aria-hidden="true">
                    <i class="fa-solid fa-sliders"></i>
                </div>
                <div class="settings-header-text">
                    <h2>Settings</h2>
                    <p>Tune sound, voice, and display for your adventure.</p>
                </div>
            </header>

            <div class="settings-body">

                <section class="settings-section" aria-labelledby="settingsSoundTitle">
                    <h3 id="settingsSoundTitle" class="settings-section-title">
                        <i class="fa-solid fa-music"></i>
                        Sound
                    </h3>

                    <div class="setting-row">
                        <div class="setting-copy">
